# TRACE-X Backend Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# CORS Settings (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Database Settings
# By default, uses local SQLite database tracex.db. For PostgreSQL: postgresql://user:password@localhost:5432/tracex
DATABASE_URL=sqlite:///./data/tracex.db

# Storage directory for digital evidence files (RFC-822 EML, attachments, hashes)
EVIDENCE_VAULT_DIR=./data/evidence_vault

# Optional API Keys for Live External Threat Intelligence Feeds
# When empty, TRACE-X automatically uses built-in heuristic DNS lookups & offline intelligence correlation with clear labels.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
IPINFO_TOKEN=

# Optional AI LLM Provider Configuration for TRACE-X Assistant
# When no API key is configured, TRACE-X runs in built-in Rule-Based Cyber-Forensic Expert Mode automatically.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3
GROQ_API_KEY=
